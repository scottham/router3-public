{
  "name": "router3",
  "version": "0.7.0",
  "private": true,
  "license": "MIT",
  "repository": "github:scottham/router3-public",
  "homepage": "https://router3.ai",
  "type": "module",
  "description": "Self-custodial AI gateway: USDC prepaid pools on Monad, PostgreSQL accounting, model providers behind one OpenAI/Anthropic/Responses API.",
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "mainnet:local:configure": "node scripts/configure-mainnet-local.mjs",
    "mainnet:local:build": "docker compose --env-file .env.mainnet-local -f docker-compose.production.yml build api web",
    "mainnet:local:init-db": "docker compose --env-file .env.mainnet-local -f docker-compose.production.yml run --rm bootstrap",
    "mainnet:local:start": "docker compose --env-file .env.mainnet-local -f docker-compose.production.yml up -d db redis api signer reconciler collector catalog web",
    "mainnet:local:tunnel": "docker compose --env-file .env.mainnet-local -f docker-compose.production.yml --profile cloudflare up -d cloudflared",
    "mainnet:local:metrics": "docker compose --env-file .env.mainnet-local -f docker-compose.production.yml --profile metrics up -d metrics alloy",
    "mainnet:local:recheck-models": "docker compose --env-file .env.mainnet-local -f docker-compose.production.yml run --rm -e CATALOG_RECHECK_ACCESS=true catalog node ops/catalog-worker.mjs --once",
    "grafana:dashboard": "node --env-file=.env.mainnet-local ops/grafana-dashboard.mjs",
    "mainnet:local:stop": "docker compose --env-file .env.mainnet-local -f docker-compose.production.yml stop",
    "mainnet:local:check-keys": "docker compose --env-file .env.mainnet-local -f docker-compose.production.yml run --rm --no-deps catalog node ops/check-provider-keys.mjs",
    "mainnet:local:status": "docker compose --env-file .env.mainnet-local -f docker-compose.production.yml ps",
    "mainnet:local:backup": "node scripts/backup-mainnet-local.mjs",
    "dev": "node --env-file-if-exists=.env --watch src/server.js",
    "start": "node --env-file-if-exists=.env src/server.js",
    "worker:reconciler": "node --env-file-if-exists=.env scripts/run-worker.mjs reconciler",
    "test": "node --test --test-reporter=spec test/*.test.js",
    "test:openai-sdk-compat": "node scripts/verify-openai-sdk-compat.mjs",
    "test:gateway-e2e": "node scripts/verify-gateway-e2e.mjs",
    "test:agent-e2e": "node scripts/verify-agent-protocols-e2e.mjs",
    "test:prompt-cache-e2e": "node scripts/verify-prompt-cache-e2e.mjs",
    "test:auth-local": "node scripts/verify-local-wallet-auth.mjs",
    "check:syntax": "node scripts/check-syntax.mjs",
    "check:package": "node scripts/check-package.mjs",
    "verify": "npm run check:syntax && npm run check:package && npm test && npm run secrets:check",
    "contracts:build": "node scripts/build-pool-artifact.mjs",
    "contracts:verify": "node scripts/verify-pool-bytecode.mjs",
    "pool:deploy": "node scripts/deploy-pool.mjs",
    "secrets:generate": "node scripts/generate-secrets.mjs",
    "secrets:check": "node scripts/check-no-local-secrets.mjs",
    "env:complete": "node scripts/complete-local-env.mjs",
    "db:configure-local": "node scripts/configure-local-db.mjs",
    "web:install": "npm --prefix web ci --ignore-scripts && npm --prefix web run prepare:wallet-sdk",
    "test:wallet-sdk": "npm --prefix web run test:wallet-sdk",
    "web:dev": "npm --prefix web run dev",
    "web:build": "npm --prefix web run build",
    "supabase:start": "npx supabase start",
    "supabase:stop": "npx supabase stop",
    "supabase:reset": "npx supabase db reset",
    "supabase:push": "npx supabase db push",
    "web:preview": "npm --prefix web run dev -- --open /preview.html",
    "worker:collector": "node --env-file-if-exists=.env scripts/run-worker.mjs collector",
    "test:redis-scaling": "node scripts/verify-redis-scaling.mjs",
    "test:x402-db": "node scripts/verify-x402-db.mjs",
    "test:pool-db": "node scripts/verify-pool-db.mjs",
    "test:pool-recovery-e2e": "node scripts/verify-pool-recovery-e2e.mjs",
    "test:pool-fork": "node scripts/verify-pool-fork.mjs",
    "test:x402-fork": "node scripts/verify-x402-fork.mjs",
    "test:x402-live": "node --env-file=.env.mainnet-local --env-file=.env scripts/verify-x402-live.mjs",
    "proxy": "node clients/x402-proxy/cli.mjs",
    "test:mainnet-backup": "node scripts/verify-mainnet-backup.mjs"
  },
  "dependencies": {
    "@fastify/cors": "11.3.0",
    "@fastify/helmet": "13.1.1",
    "@fastify/rate-limit": "11.2.0",
    "@x402/core": "2.29.0",
    "@x402/evm": "2.29.0",
    "ethers": "6.17.0",
    "fastify": "5.12.7",
    "ioredis": "5.8.2",
    "pg": "8.23.0",
    "siwe": "3.0.0",
    "viem": "^2.56.1",
    "yaml": "2.9.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@openzeppelin/contracts": "5.6.1",
    "@x402/fetch": "2.29.0",
    "forge-std": "github:foundry-rs/forge-std#v1.16.1",
    "openai": "7.38.0",
    "supabase": "2.116.0"
  },
  "overrides": {
    "tmp": "0.2.7"
  }
}
