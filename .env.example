# Self-hosting (docs/SELF_HOSTING.md): npm ci, fill these five, then
#   npm run pool:deploy                                   # writes POOL_ADDRESS, POOL_CODE_HASH below
#   npm run mainnet:local:configure -- --public https://your.domain
#   npm run mainnet:local:build && npm run mainnet:local:init-db && npm run mainnet:local:start
# Everything else (secrets, database roles, the Settler key) is generated.

TREASURY_ADDRESS=                 # receives the money; a multisig or hardware wallet, never on the server
MONAD_RPC_URL=https://rpc.monad.xyz   # a dedicated RPC for production; the public one is rate limited
DEEPSEEK_API_KEY=                 # provider env file is read by API, collector, catalog and bootstrap
OPENROUTER_MANAGEMENT_KEY=        # OpenRouter *management* key (mints one call key per paying wallet); optional
DEPLOYER_PRIVATE_KEY=             # pays the one pool deployment (~0.5 MON); remove it afterwards

# Written by pool:deploy. An existing pool can be entered by hand.
POOL_ADDRESS=
POOL_CODE_HASH=

# Optional
# POOL_ADMIN_ADDRESS=             # may pause the pool's settlements; default: the Treasury
# AUTH_ALLOWED_ADDRESSES=         # comma-separated wallets; set = only these may sign in and pay
# CLOUDFLARE_TUNNEL_TOKEN=        # docs/CLOUDFLARE.md
# CALL_SERVICE_FEE_BPS=100        # per-call fee on top of the provider price (1%)
# X402_FACILITATOR_URL=https://x402-facilitator.molandak.org

# ---------------------------------------------------------------------------
# Local development against docker-compose.yml and a local Supabase
# (npm run env:complete fills in the secrets). Not needed for self-hosting.
PUBLIC_APP_URL=http://localhost:3000
VITE_API_BASE_URL=http://localhost:8787
CORS_ORIGINS=http://localhost:3000
AUTH_SESSION_HMAC_SECRET=REPLACE_WITH_AT_LEAST_32_RANDOM_CHARACTERS
DATABASE_URL_API=postgresql://gateway_api:REPLACE_API_DB_PASSWORD@127.0.0.1:54322/postgres
DATABASE_URL_SETTLER=postgresql://gateway_settler:REPLACE_SETTLER_DB_PASSWORD@127.0.0.1:54322/postgres
DATABASE_URL_RECONCILER=postgresql://gateway_reconciler:REPLACE_RECONCILER_DB_PASSWORD@127.0.0.1:54322/postgres
DATABASE_URL_API_DOCKER=postgresql://gateway_api:REPLACE_API_DB_PASSWORD@host.docker.internal:54322/postgres
DATABASE_URL_RECONCILER_DOCKER=postgresql://gateway_reconciler:REPLACE_RECONCILER_DB_PASSWORD@host.docker.internal:54322/postgres
RESPONSE_ENCRYPTION_KEYS=REPLACE_KEY_ID:AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA=
PROVIDER_CONFIG_FILE=./providers/providers.legacy.json
MODEL_MARKUP_BPS=0
REAL_MODEL_CALLS_ENABLED=false
SETTLER_ADDRESS=
SETTLER_SIGNER_URL=http://127.0.0.1:8790/sign
SETTLER_SIGNER_BEARER_TOKEN=REPLACE_WITH_AT_LEAST_32_RANDOM_CHARACTERS
REDIS_PASSWORD=REPLACE_WITH_GENERATED_SECRET
REDIS_URL=
REDIS_NAMESPACE=router3-dev
